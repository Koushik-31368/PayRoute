# PayRoute Frontend — Environment Variables
# Copy this file to .env.local and fill in your values for local development.
# NEVER commit .env.local to version control.

# URL of the Spring Boot backend REST API.
# In development, Vite proxies /api to localhost:8080 so you can leave this blank.
# In production, set this to the full backend URL (e.g. https://api.your-domain.com).
VITE_API_URL=

# WebSocket endpoint for STOMP/SockJS connection.
# In development, Vite proxies /ws to localhost:8080 so you can leave this blank.
# In production, set this to the full WS backend URL (e.g. https://api.your-domain.com/ws).
VITE_WS_URL=
