# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payroute
SPRING_DATASOURCE_USERNAME=payroute
SPRING_DATASOURCE_PASSWORD=payroute

# Server
SERVER_PORT=8080

# Circuit Breaker Tuning
PAYROUTE_CIRCUIT_BREAKER_WINDOW_SIZE=20
PAYROUTE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.50
PAYROUTE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Anomaly Detection Tuning
PAYROUTE_ANOMALY_LARGE_AMOUNT_THRESHOLD=100000
PAYROUTE_ANOMALY_BURST_LIMIT=5
PAYROUTE_ANOMALY_BURST_WINDOW_SECONDS=60
